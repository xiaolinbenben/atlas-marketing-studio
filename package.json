{
  "name": "atlas-marketing-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas Marketing Studio is an open-source AI e-commerce ad studio for generating UGC product ads, reference-ad remakes, AI drama ads, and ad skits with Atlas Cloud multi-model workflows.",
  "scripts": {
    "predev": "DATABASE_URL=file:./dev.db prisma migrate deploy",
    "dev": "DATABASE_URL=file:./dev.db next dev",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "test": "node --test --experimental-strip-types --no-warnings test/**/*.test.ts",
    "lint": "next lint",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@prisma/client": "6.19.3",
    "lucide-react": "^1.22.0",
    "next": "^14.2.15",
    "next-auth": "^4.24.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
